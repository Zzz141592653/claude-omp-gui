{
  "name": "agent-sessions",
  "displayName": "Claude Code & OMP GUI — Sessions, Usage & Review",
  "description": "GUI for Claude Code and OMP (Oh My Pi): live session browser, per-model token speed (tok/s) & Today/Month spend tracker with mascot toasts, Mermaid/SVG/table chart viewer, and inline file review comments.",
  "version": "1.5.10",
  "publisher": "jinxinyang",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "AI",
    "Chat",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "claude-code",
    "claude",
    "omp",
    "oh-my-pi",
    "gui",
    "sessions",
    "usage",
    "cost",
    "spend",
    "code-review",
    "dashboard",
    "cursor",
    "mermaid",
    "agent"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:agentSessions.open",
    "onWebviewPanel:agentSessions",
    "onWebviewPanel:agentSessionsFile"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agentSessions.open",
        "title": "Sessions: Open Session Library",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "agentSessions.selectAll",
        "title": "Sessions: Select All in Input"
      },
      {
        "command": "agentSessions.find",
        "title": "Sessions: Find in Active Panel"
      }
    ],
    "keybindings": [
      {
        "command": "agentSessions.open",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      },
      {
        "command": "agentSessions.selectAll",
        "key": "ctrl+a",
        "mac": "cmd+a",
        "when": "agentSessionsInputFocused"
      },
      {
        "command": "agentSessions.find",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeWebviewPanelId == 'agentSessionsFile' || activeWebviewPanelId == 'agentSessions'"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "agentSessions.open",
          "group": "navigation"
        }
      ]
    }
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.12.0",
    "katex": "^0.19.0",
    "markdown-it": "^14.3.2"
  },
  "homepage": "https://github.com/Zzz141592653/claude-omp-gui#readme",
  "bugs": {
    "url": "https://github.com/Zzz141592653/claude-omp-gui/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Zzz141592653/claude-omp-gui.git"
  },
  "scripts": {
    "test": "node --test",
    "package": "vsce package",
    "install:local": "VSIX=\"agent-sessions-$(node -p 'require(\"./package.json\").version').vsix\" && npm run package && /Applications/Cursor.app/Contents/Resources/app/bin/cursor --install-extension \"$VSIX\" --force && for d in ~/.cursor/extensions/*agent-sessions*; do [ -d \"$d\" ] && cp -f package.json extension.js sources.js review.js readme.md changelog.md \"$d/\" && cp -rf media/* \"$d/media/\" && mkdir -p \"$d/node_modules/@highlightjs/cdn-assets\" && cp -f node_modules/@highlightjs/cdn-assets/highlight.min.js node_modules/@highlightjs/cdn-assets/package.json \"$d/node_modules/@highlightjs/cdn-assets/\"; done && rm -f \"$VSIX\"",
    "publish:ovsx": "npx ovsx publish -p \"${OVSX_PAT:-$(tr -d '[:space:]' < ~/open-vsx.token 2>/dev/null)}\""
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2"
  }
}
